# Read by docker compose from the repo root. Copy to .env to override.
# Change a host port when a local service already listens on the default,
# and point DATABASE_URL or REDIS_URL in api/.env at the new port.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
POSTGRES_USER=mc
POSTGRES_PASSWORD=mc
POSTGRES_DB=memorycard
