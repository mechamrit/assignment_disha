{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(uv run *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose up -d*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(curl -s http://localhost*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(*prisma migrate reset*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/state-reminder.sh"
          }
        ]
      }
    ]
  }
}
